{
  "Comment": "Durable campaign with explicit craft position and failure recovery",
  "StartAt": "Plan",
  "States": {
    "Plan": {
      "Type": "Task",
      "Resource": "${PlanArn}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.step_error",
          "Next": "Recover"
        }
      ],
      "Next": "MoreEmails"
    },
    "CraftEmail": {
      "Type": "Task",
      "Resource": "${CraftArn}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.step_error",
          "Next": "Recover"
        }
      ],
      "Next": "MoreEmails"
    },
    "Finish": {
      "Type": "Task",
      "Resource": "${FinishArn}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 5,
          "MaxAttempts": 3
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.step_error",
          "Next": "Recover"
        }
      ],
      "End": true
    },
    "MoreEmails": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.more",
          "BooleanEquals": true,
          "Next": "CraftEmail"
        }
      ],
      "Default": "Finish"
    },
    "Recover": {
      "Type": "Task",
      "Resource": "${RecoveryArn}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 30,
          "BackoffRate": 1,
          "MaxAttempts": 35
        }
      ],
      "End": true
    }
  }
}

# Database
DATABASE_URL=sqlite:///./marketingos.db

# AI provider selection (claude | openai | gemini | local)
AI_PROVIDER=openai

# OpenAI: Codex CLI, billed against your authenticated ChatGPT subscription.
# Do not set OPENAI_API_KEY for subscription billing.
OPENAI_MODEL=gpt-5.6-sol

# Claude
# Billed against your Claude subscription via the Claude Code CLI (OAuth in
# ~/.claude/.credentials.json) - do NOT set ANTHROPIC_API_KEY, it would make
# the CLI switch to API-key billing instead. Run `claude login` once if you
# haven't authenticated the CLI yet. Set CLAUDE_CLI_PATH only if the CLI
# isn't auto-discovered.
ANTHROPIC_MODEL=claude-sonnet-4-6
# CLAUDE_CLI_PATH=

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Accounts
# Off by default: the product keeps its single-workspace shape on a laptop.
# Forced ON in production - see app.core.config.get_settings.
AUTH_REQUIRED=false
# Whether strangers may create their own account. Leave off and use
# `python -m scripts.create_user` to invite testers.
ALLOW_PUBLIC_SIGNUP=false
# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
# A production process refuses to start while these are still the dev values.
# JWT_SECRET=
# PASSWORD_PEPPER=
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30

# Persistent single-worker admission limits. Monthly quota is per account;
# campaigns, compilations, market jobs and image extraction each reserve a job.
MAX_CONCURRENT_JOBS=4
MAX_JOBS_PER_ACCOUNT=2

# Prepaid credits (off until checkout, signed webhook and API metering are ready).
# AI_BILLING=api
# OPENAI_API_KEY=       # Required if a paid route uses OpenAI
# ANTHROPIC_API_KEY=    # Required if a paid route uses Anthropic
# CREDIT_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=  # Secret for MarketingOS's /api/credits/webhook endpoint
# PUBLIC_APP_URL=https://your-app.example

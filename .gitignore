# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Backend runtime
backend/*.db
# ...and the hand-made snapshots beside it. `*.db` does not match them:
# the name has to *end* in .db, and `marketingos.db.pre-accounts.bak` does
# not, which is how four SQLite files became tracked source.
backend/*.db.*
backend/*.db-shm
backend/*.db-wal
backend/.env

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
!frontend/.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code
.claude/settings.local.json
.scratch/

# Back-office console
administration/frontend/node_modules/
administration/frontend/.next/
administration/frontend/out/

# Vendored into the admin Lambda bundle by its buildspec, never committed.
administration/backend/app/

# SAM build artifacts
**/.aws-sam/

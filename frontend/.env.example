# Where the API lives. Must include the /api mount.
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=http://localhost:8000

# Whether this deployment has accounts. Mirrors the API's own AUTH_REQUIRED,
# and must agree with it: the sign-in redirect in src/proxy.ts reads this, and
# a frontend that thinks auth is off in front of an API that demands it shows a
# workspace full of 401s instead of a login page.
#
# Leave it unset (or false) for a laptop: no login page, one workspace, which
# is the shape the product had before accounts existed.
NEXT_PUBLIC_AUTH_REQUIRED=false

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash"
    ],
    "ask": [
      "Bash(python -m app.evaluation.*)",
      "Bash(.venv/Scripts/python.exe -m app.evaluation.*)",
      "Bash(./.venv/Scripts/python.exe -m app.evaluation.*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)"
    ]
  }
}
